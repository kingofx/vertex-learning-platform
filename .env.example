# Clerk: copy to .env.local and fill in from the Clerk Dashboard (or `npx clerk@latest env pull`).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity: project id and dataset from sanity.io/manage (safe for the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Server only. Viewer token from sanity.io/manage > API > Tokens. Never expose to the browser.
SANITY_API_READ_TOKEN=

# Search. Server only, never NEXT_PUBLIC_. See docs/context-mcp-config.md.
# Context MCP endpoint URL from the Context app in the Sanity Dashboard.
SANITY_CONTEXT_MCP_URL=
# Organization API token with Context Viewer permissions.
SANITY_CONTEXT_API_TOKEN=
OPENAI_API_KEY=
# Optional, defaults to gpt-4.1-mini.
OPENAI_MODEL=
